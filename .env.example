# Главный админ
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=changeme
SUPERADMIN_TELEGRAM_ID=12345678

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[password]@xxxx.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@xxxx.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379

# Бот
BOT_WEBHOOK_BASE_URL=https://your-domain.com
BOT_WEBHOOK_SECRET=random-secret-string

# Прочее
NODE_ENV=development
TZ=Europe/Kyiv
LOG_LEVEL=info
